            }
          ]
        },
        {
          "group": "Entonação — Frases Declarativas e Interrogativas",
          "phonemes": [
            {
              "symbol": "Entonação descendente (↘)",
              "ipa": "/↘/",
              "description": "Frases declarativas (afirmativas) e perguntas com palavra interrogativa (W-Fragen: wer, was, wo, wann...) terminam com entonação descendente — a voz cai no final. Contraste com o português brasileiro, que às vezes sobe mesmo em frases afirmativas. Exemplos: 'Ich wohne in Berlin.' (desce), 'Wo wohnst du?' (desce). A entonação descendente também aparece em ordens e respostas completas.",
              "examples": [
                {
                  "word": "Ich wohne in Berlin.",
                  "phonetic": "↗Ich ˈWOHne in Ber↘LIN.",
                  "translation": "Moro em Berlim."
                },
                {
                  "word": "Wo wohnst du?",
                  "phonetic": "↗Wo ˈWOHNST du↘?",
                  "translation": "Onde você mora?"
                },
                {
                  "word": "Das ist mein Buch.",
                  "phonetic": "↗Das ist mein ˈBUCH↘.",
                  "translation": "Este é meu livro."
                }
              ],
              "forvo_url": null,
              "youtube_url": null
            },
            {
              "symbol": "Entonação ascendente (↗)",
              "ipa": "/↗/",
              "description": "Perguntas de sim/não (Ja/Nein-Fragen) — sem palavra interrogativa, com verbo no início — terminam com entonação ascendente, a voz sobe no final. Este padrão é semelhante ao português. Exemplos: 'Bist du müde?' (sobe), 'Hast du Zeit?' (sobe). Também sobe em listas quando há mais itens por vir, e em perguntas de confirmação (Rückfragen).",
              "examples": [
                {
                  "word": "Bist du müde?",
                  "phonetic": "Bist du ˈmü↗DE?",
                  "translation": "Você está cansado?"
                },
                {
                  "word": "Hast du Zeit?",
                  "phonetic": "Hast du ˈZEIT↗?",
                  "translation": "Você tem tempo?"
                },
                {
                  "word": "Kommst du auch?",
                  "phonetic": "Kommst du ˈAUCH↗?",
                  "translation": "Você também vem?"
                }
              ],
              "forvo_url": null,
              "youtube_url": null
            }
          ]
        }
      ]
    }
  ]
